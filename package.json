{
  "name": "nuclear-60-seconds-short",
  "version": "1.0.0",
  "private": true,
  "description": "Vertical low-poly 3D short: 'What if 60 seconds were left before a nuclear blast?' rendered with Remotion + React Three Fiber",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "audio": "python3 scripts/build_audio.py",
    "subs": "python3 scripts/build_subtitles.py",
    "still": "node scripts/render.mjs --still",
    "test-render": "node scripts/render.mjs --test",
    "render": "node scripts/render.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.2.8",
    "@fontsource/russo-one": "^5.2.7",
    "@react-three/fiber": "^9.4.0",
    "@remotion/bundler": "^4.0.541",
    "@remotion/cli": "^4.0.541",
    "@remotion/renderer": "^4.0.541",
    "@remotion/three": "^4.0.541",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remotion": "^4.0.541",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/three": "^0.180.0",
    "typescript": "^5.9.3"
  }
}
